<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Current_Stock_Level__c</field>
        <field>Reorder_Threshold__c</field>
        <field>Name__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <formula>Current_Stock_Level__c &lt; Reorder_Threshold__c</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Inventory Manager Review</label>
        <name>Inventory_Manager_Review</name>
    </approvalStep>
    <description>Some items might require manager approval before reordering. We’ll trigger an Approval Process when such an item’s stock falls below the reorder threshold.</description>
    <emailTemplate>unfiled$public/Inventory_Reorder_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( Current_Stock_Level__c &lt; Reorder_Threshold__c , Requires_Manager_Approval__c =TRUE)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Reorder_Approved_Restock</name>
            <type>Task</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Inventory_reorder_request_for_was_rejected_Please_review_and_update_stock_detail</name>
            <type>Task</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Inventory Reorder Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
